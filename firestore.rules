rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        // .get() with a default — reading a missing map key is an evaluation error,
        // and a document created by saveFieldToCloud() carries no 'role' key.
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin';
    }

    // The single bootstrap owner account, allowed to hold the admin role.
    // Without this, the very first admin document could never be created.
    function isOwnerEmail() {
      return isSignedIn() && request.auth.token.email == 'wbddwd55@gmail.com';
    }

    // True when the incoming write does not change the caller's own privilege level.
    // A brand new document may only be created with the 'user' role.
    function roleUnchanged() {
      return !('role' in request.resource.data)
        || (resource == null && request.resource.data.role == 'user')
        // .get() with a default: reading a missing key directly is an evaluation error,
        // and documents created by saveFieldToCloud() carry no 'role' field at all.
        || (resource != null && request.resource.data.role == resource.data.get('role', 'user'));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Owners may write their own document but may NOT grant themselves a role.
      // Only an existing admin can change the 'role' field.
      allow create, update: if isAdmin()
        || isOwnerEmail()
        || (isSignedIn() && request.auth.uid == userId && roleUnchanged());

      allow delete: if isAdmin();
    }

    match /feedbacks/{feedbackId} {
      // Any signed-in user may file feedback, but only about themselves,
      // always as 'pending', and with a bounded payload.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 100;

      allow read, update, delete: if isAdmin();
    }
  }
}
